# Aura Music Studio runtime configuration
# Copy to .env locally. Never commit real API keys.

# Reliable hosted ACE-Step route (optional, recommended)
DEAPI_API_KEY=
DEAPI_BASE_URL=https://api.deapi.ai
DEAPI_MUSIC_MODEL=AceStep_1_5_XL_Turbo_INT8
DEAPI_TIMEOUT_SECONDS=1800

# Public/hosted Gradio ACE-Step failover
AURA_ACESTEP_SPACES=critesjosh/ace-step-music-studio,ACE-Step/Ace-Step-v1.5
HF_TOKEN=

# Local/self-hosted renderers. Each command receives AURA_PROJECT, AURA_SOURCE,
# AURA_GUIDE, AURA_PROMPT, AURA_NEGATIVE_PROMPT, AURA_BPM, AURA_KEY,
# AURA_METER, AURA_DURATION and AURA_OUTPUT.
AURA_LOCAL_RENDER_CMD=
AURA_MUSER_CMD=
AURA_YUE_CMD=

# Optional post-production engines
AURA_DIFFSINGER_CMD=
AURA_RVC_CMD=
AURA_GUITAR_LAYER_CMD=

# Score-guide rendering
AURA_SOUNDFONT=/usr/share/sounds/sf2/FluidR3_GM.sf2

# Autopilot
AURA_PROJECTS_DIR=projects
AURA_POLL_SECONDS=60
