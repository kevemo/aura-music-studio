# The Live Sound Studio runtime configuration
# Elevate Souls Productions Presents: The Live Sound Studio
# Copy to .env locally. Never commit real secrets, passwords, private tokens or model credentials.

AURA_PROJECTS_ROOT=projects
LSS_DB_PATH=data/live_sound_studio.sqlite3

# Public account/customer portal
LSS_PUBLIC_BASE_URL=http://127.0.0.1:8000
LSS_COOKIE_SECURE=false

# Self-hosted public address manager — no Cloudflare or paid domain required.
# LSS_DDNS_PROVIDER: none | direct | freedns | duckdns
# `direct` exposes the router/public IP without DDNS. `freedns`/`duckdns` keep a free hostname updated.
LSS_DDNS_PROVIDER=none
LSS_PUBLIC_HOST=
# Caddy site address. For a free hostname use e.g. my-studio.example-ddns.net.
# For direct-IP HTTP fallback leave as http://:80.
LSS_PUBLIC_SITE_ADDRESS=http://:80
LSS_PUBLIC_ADDRESS_STATUS=data/public_address_status.json
LSS_DDNS_INTERVAL_SECONDS=300
LSS_PUBLIC_IP_DISCOVERY=true
LSS_PUBLIC_IPV4_DISCOVERY_URLS=https://api.ipify.org,https://ifconfig.me/ip
LSS_UPNP_DISCOVERY=true
# Deliberately OFF by default. If true and miniupnpc is installed, Aura may request TCP 80/443 mappings.
LSS_UPNP_PORT_FORWARD=false
LSS_DIRECT_PUBLIC_PORT=80
LSS_FREEDNS_UPDATE_URL=
LSS_DUCKDNS_SUBDOMAIN=
LSS_DUCKDNS_TOKEN=

# ESP-owned local backup rotation. Disabled by default.
LSS_BACKUP_DIR=backups
LSS_BACKUP_STATUS=data/backup_scheduler_status.json
LSS_AUTO_BACKUP_ENABLED=false
LSS_AUTO_BACKUP_INTERVAL_HOURS=24
LSS_AUTO_BACKUP_KEEP=7
LSS_AUTO_BACKUP_INCLUDE_OUTPUTS=false
LSS_AUTO_BACKUP_INCLUDE_WORK=true
# Optional standard age recipient (e.g. age1...). Private age identity/key is NEVER stored here.
LSS_BACKUP_AGE_RECIPIENT=

# ESP compute-node federation. Nodes connect outbound to this Studio; no public port is needed on worker nodes.
LSS_NODE_COORDINATOR_ENABLED=true
LSS_NODE_ENROLLMENT_TTL_MINUTES=30
LSS_NODE_HEARTBEAT_SECONDS=30
LSS_NODE_LEASE_SECONDS=3600
LSS_NODE_MAX_BUNDLE_BYTES=2147483648
LSS_NODE_COORDINATOR_URL=
LSS_NODE_ID=
LSS_NODE_SECRET=
LSS_NODE_NAME=
LSS_NODE_CAPABILITIES=music_generation,engineering
LSS_NODE_WORK_DIR=data/node_work

# Membership approval + ESP owner administration
LSS_MEMBERSHIP_APPROVAL_EMAIL=elevatesoulsproductions@gmail.com
LSS_OWNER_EMAIL=elevatesoulsproductions@gmail.com
LSS_APPROVAL_TOKEN_HOURS=72
# Use a long random owner-admin secret. Do not use an email-account password here.
LSS_ADMIN_KEY=

# Output/provenance integrity. Set a long random secret only in deployment secrets.
LSS_PROVENANCE_SECRET=

# Current ESP PayPal manual payment links
# Opening/returning from these links is never treated as proof of payment.
LSS_PAYPAL_BASE_URL=https://www.paypal.com/invoice/p/#8MW58LYURC584SWJ
LSS_PAYPAL_PRO_URL=https://www.paypal.com/invoice/p/#678LURGCLH77JDGH
LSS_PAYMENT_PROVIDER=paypal
LSS_PAYMENT_MODE=manual_invoice_link

# SMTP settings for membership + ESP Command Center approval email.
# For Gmail, use an app-specific password/OAuth credential where available; never commit
# the normal Google account password and never reuse LSS_ADMIN_KEY as an SMTP credential.
LSS_SMTP_HOST=smtp.gmail.com
LSS_SMTP_PORT=587
LSS_SMTP_USERNAME=
LSS_SMTP_PASSWORD=
LSS_SMTP_FROM=
LSS_SMTP_STARTTLS=true

# -----------------------------------------------------------------------------
# Aura Companion / OpenAI cloud intelligence
# -----------------------------------------------------------------------------
# Create this key in the OpenAI Platform and store it only as a backend/deployment secret.
OPENAI_API_KEY=
# Base/non-Pro Aura favors the balanced model; Pro/owner can use the frontier model.
AURA_OPENAI_CHAT_MODEL=gpt-5.6-terra
AURA_OPENAI_CHAT_PRO_MODEL=gpt-5.6-sol
AURA_COMPANION_MAX_OUTPUT_TOKENS=4096
AURA_COMPANION_TIMEOUT=180
AURA_COMPANION_USE_OLLAMA=true
AURA_COMPANION_OLLAMA_MODEL=qwen3:4b

# Full Aura chat/workpage attachments. These remain tenant-bound and are never public URLs.
AURA_CHAT_UPLOAD_DIR=data/aura_chat_uploads
AURA_CHAT_MAX_UPLOAD_BYTES=67108864
AURA_CHAT_TEXT_ATTACHMENT_CHARS=50000

# -----------------------------------------------------------------------------
# Canonical embodied Aura — AuraCore-Osiris
# -----------------------------------------------------------------------------
# The application will not substitute a stock human avatar if this model is absent/invalid.
# The final binary must match docs/AURA_CANONICAL_3D_CHARACTER.md and pass the VRM validator.
AURA_AVATAR_MODEL_PATH=aura_music_studio/static/aura/aura.glb
AURA_AVATAR_REFERENCE_DIR=data/aura_character_references
# Dedicated 3D build-host adapters; leave blank on ordinary web/app hosts.
AURA_AVATAR_IMAGE_TO_3D_CMD=
AURA_AVATAR_RIG_CMD=
AURA_AVATAR_VRM_CMD=
# Optional timing-aware viseme/phoneme service for higher-precision facial speech animation.
AURA_TTS_TIMING_URL=

# Global language / translation layer. English is the default UI locale.
AURA_TRANSLATION_MODEL=gpt-5.6-luna
AURA_TRANSLATION_OLLAMA_MODEL=qwen3:4b
AURA_TRANSLATION_TIMEOUT=120
AURA_SONG_LANGUAGE_MODEL=gpt-5.6-terra
AURA_SONG_LANGUAGE_OLLAMA_MODEL=qwen3:8b
AURA_SONG_LANGUAGE_TIMEOUT=180
AURA_LIVE_TRANSLATE_URL=
AURA_LIVE_TRANSLATE_MODEL=gpt-realtime-translate
AURA_LIVE_TRANSLATE_SEGMENT_SECONDS=2.5
AURA_LIVE_TRANSLATE_MAX_CHUNK_BYTES=8388608

# Aura Internet gateway. docker-compose supplies its private SearXNG URL automatically.
AURA_WEB_ENABLED=true
AURA_WEB_ALLOW_HTTP=false
AURA_WEB_TIMEOUT=25
AURA_WEB_MAX_BYTES=5242880
AURA_WEB_MIN_INTERVAL=0.5
AURA_WEB_CACHE_TTL=3600
AURA_WEB_CACHE_DIR=data/web_cache
AURA_WEB_ALLOWED_DOMAINS=
AURA_WEB_BLOCKED_DOMAINS=localhost,127.0.0.1,0.0.0.0,::1
AURA_SEARXNG_URL=

# Aura's local reasoning/songwriting brain. docker-compose.local-ai.yml supplies the private URL.
OLLAMA_BASE_URL=
AURA_LLM_PROVIDER=auto
AURA_OLLAMA_MODEL=qwen3:4b
AURA_PRODUCER_USE_OLLAMA=true
AURA_LLM_BASE_URL=
AURA_LLM_API_KEY=
AURA_LLM_MODEL=
AURA_PRODUCER_LLM_URL=
AURA_PRODUCER_LLM_KEY=

# -----------------------------------------------------------------------------
# Image / Poster Studio
# -----------------------------------------------------------------------------
AURA_OPENAI_IMAGE_MODEL=gpt-image-2
AURA_IMAGE_OUTPUT_DIR=outputs/images
AURA_IMAGE_MAX_BYTES=67108864
AURA_IMAGE_API_TIMEOUT=180
AURA_IMAGE_RENDER_CMD=
AURA_IMAGE_MODEL=local-image-renderer
AURA_IMAGE_RENDER_TIMEOUT=900

# -----------------------------------------------------------------------------
# Video Studio
# -----------------------------------------------------------------------------
AURA_OPENAI_VIDEO_MODEL=sora-2
AURA_OPENAI_VIDEO_PRO_MODEL=sora-2-pro
RUNWAYML_API_SECRET=
AURA_RUNWAY_VIDEO_MODEL=gen4.5
AURA_RUNWAY_VIDEO_TO_VIDEO_MODEL=aleph2
AURA_VIDEO_OUTPUT_DIR=outputs/video
AURA_VIDEO_MAX_DOWNLOAD_BYTES=1073741824
AURA_VIDEO_RENDER_TIMEOUT=1800
AURA_VIDEO_FFMPEG_PRESET=medium

# Self-hosted/open video engines. Each command must create a real MP4 or fail.
AURA_VIDEO_RENDER_CMD=
AURA_VIDEO_MODEL=local-video-renderer
AURA_LTX2_CMD=
AURA_LTX2_MODEL=LTX-2.3
AURA_WAN22_CMD=
AURA_WAN22_MODEL=Wan2.2
AURA_HUNYUANVIDEO_CMD=
AURA_HUNYUANVIDEO_MODEL=HunyuanVideo
AURA_COGVIDEOX_CMD=
AURA_COGVIDEOX_MODEL=CogVideoX

# Aura Music Video Director. A finished project must contain output/Aura_Final_Master.wav.
AURA_MUSIC_VIDEO_OUTPUT_DIR=outputs/music_videos
AURA_MUSIC_VIDEO_MAX_SHOTS=60

# -----------------------------------------------------------------------------
# Pro Visual FX Studio
# -----------------------------------------------------------------------------
AURA_VISUAL_FX_RENDER_CMD=
AURA_VISUAL_FX_OUTPUT_DIR=outputs/visual_fx
AURA_VISUAL_FX_RENDER_TIMEOUT=3600

# Asynchronous production queue
AURA_JOB_POLL_SECONDS=2
AURA_WORKER_ID=

# Primary standalone real-audio generation: ACE-Step 1.5 REST API
AURA_ACESTEP_API_URL=http://127.0.0.1:8001
ACESTEP_API_KEY=
AURA_ACESTEP_TIMEOUT=1800
AURA_ACESTEP_FULL_MODEL=acestep-v15-xl-turbo
AURA_ACESTEP_TRACK_MODEL=acestep-v15-base
AURA_ACESTEP_SAMPLE_MODEL=acestep-v15-base
AURA_ACESTEP_EDIT_MODEL=

# Optional self-hosted YuE service/command.
AURA_YUE_API_URL=
AURA_YUE_CMD=
AURA_YUE_MAX_SEGMENTS=2
AURA_YUE_STAGE1_MODEL=m-a-p/YuE-s1-7B-anneal-en-cot
AURA_YUE_STAGE2_MODEL=m-a-p/YuE-s2-1B-general

# Other local/open generation engines (optional router choices)
AURA_LOCAL_RENDER_CMD=
AURA_MUSER_CMD=
AURA_DIFFRHYTHM_CMD=
AURA_AUDIOCRAFT_CMD=
AURA_STABLE_AUDIO_CMD=

# Non-destructive waveform generation/repaint/extend
AURA_REGION_RENDER_CMD=

# Dedicated real-audio layer/sample generators
AURA_LAYER_RENDER_CMD=
AURA_SAMPLE_RENDER_CMD=
AURA_GUITAR_LAYER_CMD=

# Consent-gated singing/voice systems
AURA_DIFFSINGER_CMD=
AURA_SEEDVC_CMD=
AURA_RVC_CMD=

# Aura Tune / professional pitch-correction backend.
AURA_AUTOTUNE_CMD=

# Optional external VST/LV2/plugin host adapter.
AURA_PLUGIN_HOST_CMD=

# Aura speech: offline-first multilingual STT/TTS.
# STT templates may use {input}/{output}.
# TTS templates may use {text}/{output}/{locale}/{language}/{voice}/{style}/{rate}/{pitch}.
AURA_STT_CMD=
AURA_TTS_CMD=
AURA_TTS_URL=
AURA_TTS_VOICE=Aura
AURA_TTS_STYLE=warm, resonant, grounded, measured, calm, compassionate, confident; deliberate pauses; no rushed delivery
AURA_TTS_RATE=0.94
AURA_TTS_PITCH=0
AURA_WHISPER_MODEL=
AURA_PIPER_MODEL=
AURA_PIPER_DEFAULT_LOCALE=en
# AURA_PIPER_MODEL_ES=
# AURA_PIPER_MODEL_ES_ES=
# AURA_PIPER_MODEL_FR=
# AURA_PIPER_MODEL_JA=

# Audio restoration / cleanup
AURA_DENOISE_CMD=

# Neural Amp Modeler / compatible tone processor
AURA_NAM_CMD=

# Spatial Audio Framework / compatible binaural or Ambisonic renderer
AURA_SPATIAL_CMD=

# Advanced source separation
AURA_SEPARATOR_MODEL=
AURA_SEPARATOR_CMD=

# Optional local mastering fallback
AURA_PHASELIMITER_CMD=

# Optional hosted/cloud fallbacks. Leave blank for a fully standalone installation.
DEAPI_API_KEY=
DEAPI_BASE_URL=https://api.deapi.ai
DEAPI_MUSIC_MODEL=AceStep_1_5_XL_Turbo_INT8
DEAPI_TIMEOUT_SECONDS=1800
ELEVENLABS_API_KEY=
MUREKA_API_KEY=
AURA_ACESTEP_SPACES=
HF_TOKEN=

# Score/MIDI control-preview only. Symbolic guides can NEVER become Final Master.
AURA_SOUNDFONT=/usr/share/sounds/sf2/FluidR3_GM.sf2

# Autopilot / local project watcher
AURA_PROJECTS_DIR=projects
AURA_POLL_SECONDS=60
