# The Live Sound Studio runtime configuration
# Elevate Souls Productions Presents: The Live Sound Studio
# Copy to .env locally. Never commit real secrets, passwords, private tokens or model credentials.

AURA_PROJECTS_ROOT=projects
LSS_DB_PATH=data/live_sound_studio.sqlite3

# Public account/customer portal
LSS_PUBLIC_BASE_URL=http://127.0.0.1:8000
LSS_COOKIE_SECURE=false

# Membership approval + ESP owner administration
LSS_MEMBERSHIP_APPROVAL_EMAIL=elevatesoulsproductions@gmail.com
LSS_OWNER_EMAIL=elevatesoulsproductions@gmail.com
LSS_APPROVAL_TOKEN_HOURS=72
# Use a long random owner-admin secret. Do not use an email-account password here.
LSS_ADMIN_KEY=

# Output/provenance integrity. Set a long random secret only in deployment secrets.
LSS_PROVENANCE_SECRET=

# Current ESP PayPal manual payment links
# Opening/returning from these links is never treated as proof of payment.
LSS_PAYPAL_BASE_URL=https://www.paypal.com/invoice/p/#8MW58LYURC584SWJ
LSS_PAYPAL_PRO_URL=https://www.paypal.com/invoice/p/#678LURGCLH77JDGH
LSS_PAYMENT_PROVIDER=paypal
LSS_PAYMENT_MODE=manual_invoice_link

# SMTP settings for membership + ESP Command Center approval email.
# For Gmail, use an app-specific password/OAuth credential where available; never commit
# the normal Google account password and never reuse LSS_ADMIN_KEY as an SMTP credential.
LSS_SMTP_HOST=smtp.gmail.com
LSS_SMTP_PORT=587
LSS_SMTP_USERNAME=
LSS_SMTP_PASSWORD=
LSS_SMTP_FROM=
LSS_SMTP_STARTTLS=true

# Aura Internet gateway. docker-compose supplies its private SearXNG URL automatically.
AURA_WEB_ENABLED=true
AURA_WEB_ALLOW_HTTP=false
AURA_WEB_TIMEOUT=25
AURA_WEB_MAX_BYTES=5242880
AURA_WEB_MIN_INTERVAL=0.5
AURA_WEB_CACHE_TTL=3600
AURA_WEB_CACHE_DIR=data/web_cache
AURA_WEB_ALLOWED_DOMAINS=
AURA_WEB_BLOCKED_DOMAINS=localhost,127.0.0.1,0.0.0.0,::1
AURA_SEARXNG_URL=

# Aura's local reasoning/songwriting brain. docker-compose.local-ai.yml supplies the private URL.
OLLAMA_BASE_URL=
AURA_LLM_PROVIDER=auto
AURA_OLLAMA_MODEL=qwen3:4b
AURA_PRODUCER_USE_OLLAMA=true
# Optional OpenAI-compatible local endpoint if you use one instead of Ollama.
AURA_LLM_BASE_URL=
AURA_LLM_API_KEY=
AURA_LLM_MODEL=
# Optional external producer planner fallback; not required by the standalone stack.
AURA_PRODUCER_LLM_URL=
AURA_PRODUCER_LLM_KEY=

# Asynchronous production queue
AURA_JOB_POLL_SECONDS=2
AURA_WORKER_ID=

# Primary standalone real-audio generation: ACE-Step 1.5 REST API
AURA_ACESTEP_API_URL=http://127.0.0.1:8001
ACESTEP_API_KEY=
AURA_ACESTEP_TIMEOUT=1800
AURA_ACESTEP_FULL_MODEL=acestep-v15-xl-turbo
AURA_ACESTEP_TRACK_MODEL=acestep-v15-base
AURA_ACESTEP_SAMPLE_MODEL=acestep-v15-base
AURA_ACESTEP_EDIT_MODEL=

# Other local/open generation engines (optional router choices)
AURA_LOCAL_RENDER_CMD=
AURA_MUSER_CMD=
AURA_YUE_CMD=
AURA_DIFFRHYTHM_CMD=
AURA_AUDIOCRAFT_CMD=
AURA_STABLE_AUDIO_CMD=

# Non-destructive waveform generation/repaint/extend
AURA_REGION_RENDER_CMD=

# Dedicated real-audio layer/sample generators
AURA_LAYER_RENDER_CMD=
AURA_SAMPLE_RENDER_CMD=
AURA_GUITAR_LAYER_CMD=

# Consent-gated singing/voice systems
AURA_DIFFSINGER_CMD=
AURA_SEEDVC_CMD=
AURA_RVC_CMD=

# Aura Tune / professional pitch-correction backend.
# If blank, Aura uses its built-in offline note-region correction fallback.
# A configured backend receives AURA_TUNE_INPUT, AURA_TUNE_OUTPUT, AURA_TUNE_SETTINGS,
# AURA_TUNE_KEY, AURA_TUNE_SCALE, AURA_TUNE_STRENGTH, AURA_TUNE_RETUNE_MS,
# AURA_TUNE_HUMANIZE and AURA_TUNE_FORMANT_PRESERVE in its environment.
AURA_AUTOTUNE_CMD=

# Optional external VST/LV2/plugin host adapter for processors beyond Aura's stock FFmpeg DSP.
AURA_PLUGIN_HOST_CMD=

# Aura speech: offline-first STT/TTS
# STT templates may use {input}/{output}; TTS templates may use {text}/{output}.
AURA_STT_CMD=
AURA_TTS_CMD=
AURA_TTS_URL=
AURA_WHISPER_MODEL=
AURA_PIPER_MODEL=

# Audio restoration / cleanup
# AURA_DENOISE_CMD may use {input}, {output}, {hum_hz}.
AURA_DENOISE_CMD=

# Neural Amp Modeler / compatible tone processor
# Template may use {input}, {model}, {output}, {input_gain_db}, {output_gain_db}.
AURA_NAM_CMD=

# Spatial Audio Framework / compatible binaural or Ambisonic renderer
# Template may use {input}, {output}, {mode}, {azimuth}, {elevation}, {distance}.
AURA_SPATIAL_CMD=

# Advanced source separation
AURA_SEPARATOR_MODEL=
AURA_SEPARATOR_CMD=

# Optional local mastering fallback
AURA_PHASELIMITER_CMD=

# Optional hosted/cloud fallbacks. Leave blank for a fully standalone installation.
DEAPI_API_KEY=
DEAPI_BASE_URL=https://api.deapi.ai
DEAPI_MUSIC_MODEL=AceStep_1_5_XL_Turbo_INT8
DEAPI_TIMEOUT_SECONDS=1800
ELEVENLABS_API_KEY=
MUREKA_API_KEY=
AURA_ACESTEP_SPACES=
HF_TOKEN=

# Score/MIDI control-preview only. Symbolic guides can NEVER become Final Master.
AURA_SOUNDFONT=/usr/share/sounds/sf2/FluidR3_GM.sf2

# Autopilot / local project watcher
AURA_PROJECTS_DIR=projects
AURA_POLL_SECONDS=60
