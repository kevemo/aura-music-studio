# Pulsar-Frequency House runtime configuration
# Powered by Elevate Souls Productions & Aura AI Systems
# For Professional Creation Beyond The Cosmos
# Copy to .env locally. Never commit real secrets, passwords, private tokens or model credentials.

AURA_PROJECTS_ROOT=projects
LSS_DB_PATH=data/live_sound_studio.sqlite3

# Public account/customer portal
LSS_PUBLIC_BASE_URL=http://127.0.0.1:8000
LSS_COOKIE_SECURE=false

# Self-hosted public address manager — no Cloudflare or paid domain required.
# LSS_DDNS_PROVIDER: none | direct | freedns | duckdns
# `direct` exposes the router/public IP without DDNS. `freedns`/`duckdns` keep a free hostname updated.
LSS_DDNS_PROVIDER=none
LSS_PUBLIC_HOST=
# Caddy site address. For a free hostname use e.g. my-studio.example-ddns.net.
# For direct-IP HTTP fallback leave as http://:80.
LSS_PUBLIC_SITE_ADDRESS=http://:80
LSS_PUBLIC_ADDRESS_STATUS=data/public_address_status.json
LSS_DDNS_INTERVAL_SECONDS=300
LSS_PUBLIC_IP_DISCOVERY=true
# Aura first tries router UPnP discovery for the WAN-facing address, then these HTTPS reflectors if needed.
# Override/remove these if you operate your own reflector.
LSS_PUBLIC_IPV4_DISCOVERY_URLS=https://api.ipify.org,https://ifconfig.me/ip
LSS_UPNP_DISCOVERY=true
# Deliberately OFF by default. If true and miniupnpc is installed, Aura may request TCP 80/443 mappings.
LSS_UPNP_PORT_FORWARD=false
LSS_DIRECT_PUBLIC_PORT=80

# FreeDNS/Afraid.org — copy the official Direct URL for the chosen record into this deployment secret.
# Example form only; NEVER commit the real tokenized URL.
LSS_FREEDNS_UPDATE_URL=

# DuckDNS — use only if selected as the free hostname provider.
LSS_DUCKDNS_SUBDOMAIN=
LSS_DUCKDNS_TOKEN=

# ESP-owned local backup rotation. Disabled by default.
LSS_BACKUP_DIR=backups
LSS_BACKUP_STATUS=data/backup_scheduler_status.json
LSS_AUTO_BACKUP_ENABLED=false
LSS_AUTO_BACKUP_INTERVAL_HOURS=24
LSS_AUTO_BACKUP_KEEP=7
# Generated masters/stems can be very large. Default automatic backups preserve project state/work but not output bounces.
LSS_AUTO_BACKUP_INCLUDE_OUTPUTS=false
LSS_AUTO_BACKUP_INCLUDE_WORK=true
# Optional standard age recipient (e.g. age1...). Private age identity/key is NEVER stored here by the Studio.
LSS_BACKUP_AGE_RECIPIENT=

# ESP compute-node federation. Nodes connect outbound to this Studio; no public port is needed on worker nodes.
# The coordinator generates node-specific credentials during owner-approved enrollment.
LSS_NODE_COORDINATOR_ENABLED=true
LSS_NODE_ENROLLMENT_TTL_MINUTES=30
LSS_NODE_HEARTBEAT_SECONDS=30
LSS_NODE_LEASE_SECONDS=3600
LSS_NODE_MAX_BUNDLE_BYTES=2147483648
# On a compute-node machine only, set these after owner enrollment; never commit them.
LSS_NODE_COORDINATOR_URL=
LSS_NODE_ID=
LSS_NODE_SECRET=
LSS_NODE_NAME=
LSS_NODE_CAPABILITIES=music_generation,engineering
LSS_NODE_WORK_DIR=data/node_work

# Membership approval + ESP owner administration
LSS_MEMBERSHIP_APPROVAL_EMAIL=elevatesoulsproductions@gmail.com
LSS_OWNER_EMAIL=elevatesoulsproductions@gmail.com
LSS_APPROVAL_TOKEN_HOURS=72
# Use a long random owner-admin secret. It bootstraps an owner login only; new browser
# sessions use a separate random token whose hash is stored server-side.
# Do not use an email-account password here.
LSS_ADMIN_KEY=

# ESP professional-creation safety extensions. Keep private slur/blocked-term lists in
# deployment configuration rather than committing them to source control.
ESP_BLOCKED_TERMS=
ESP_BLOCKED_TERMS_FILE=

# Output/provenance integrity. Set a long random secret only in deployment secrets.
LSS_PROVENANCE_SECRET=

# Current ESP PayPal manual payment links
# Opening/returning from these links is never treated as proof of payment.
LSS_PAYPAL_BASE_URL=https://www.paypal.com/invoice/p/#8MW58LYURC584SWJ
LSS_PAYPAL_PRO_URL=https://www.paypal.com/invoice/p/#678LURGCLH77JDGH
LSS_PAYMENT_PROVIDER=paypal
LSS_PAYMENT_MODE=manual_invoice_link

# SMTP settings for membership + ESP Command Center approval email.
# For Gmail, use an app-specific password/OAuth credential where available; never commit
# the normal Google account password and never reuse LSS_ADMIN_KEY as an SMTP credential.
LSS_SMTP_HOST=smtp.gmail.com
LSS_SMTP_PORT=587
LSS_SMTP_USERNAME=
LSS_SMTP_PASSWORD=
LSS_SMTP_FROM=
LSS_SMTP_STARTTLS=true

# Aura Internet gateway. docker-compose supplies its private SearXNG URL automatically.
AURA_WEB_ENABLED=true
AURA_WEB_ALLOW_HTTP=false
AURA_WEB_TIMEOUT=25
AURA_WEB_MAX_BYTES=5242880
AURA_WEB_MIN_INTERVAL=0.5
AURA_WEB_CACHE_TTL=3600
AURA_WEB_CACHE_DIR=data/web_cache
AURA_WEB_ALLOWED_DOMAINS=
AURA_WEB_BLOCKED_DOMAINS=localhost,127.0.0.1,0.0.0.0,::1
AURA_SEARXNG_URL=

# Aura's local reasoning/songwriting brain. docker-compose.local-ai.yml supplies the private URL.
OLLAMA_BASE_URL=
AURA_LLM_PROVIDER=auto
AURA_OLLAMA_MODEL=qwen3:4b
AURA_PRODUCER_USE_OLLAMA=true
# Aura Intelligence / Aura Core is the private ChatGPT-style general assistant and Studio
# operating layer. `auto` tries Ollama then an OpenAI-compatible LOCAL endpoint.
AURA_INTELLIGENCE_PROVIDER=auto
AURA_INTELLIGENCE_MODEL=
AURA_INTELLIGENCE_TIMEOUT=180
# Optional OpenAI-compatible local endpoint if you use one instead of Ollama.
AURA_LLM_BASE_URL=
AURA_LLM_API_KEY=
AURA_LLM_MODEL=
# Optional external producer planner fallback; not required by the standalone stack.
AURA_PRODUCER_LLM_URL=
AURA_PRODUCER_LLM_KEY=

# Aura Core durable chat, file and speech storage. Each member/thread is isolated in the DB
# and file tree. Ordinary chat is NOT silently copied into long-term Aura Memory; persistent
# memories are user-approved entries only.
AURA_CHAT_ATTACHMENT_DIR=data/aura/attachments
AURA_CHAT_ATTACHMENT_MAX_MB=50
AURA_CHAT_SPEECH_DIR=data/aura/speech
# Auto-perception runs while an attachment uploads so the first reasoning turn can already
# understand a configured image/audio input. Video frame sampling is heavier and stays off
# unless explicitly enabled by the operator.
AURA_CHAT_AUTO_PERCEPTION=true
AURA_CHAT_AUTO_VIDEO_PERCEPTION=false

# Aura durable Tasks. The default Compose stack runs the separate task worker. Background
# Tasks are intentionally read-only and cannot edit projects, publish social posts, execute
# code or use voice cloning. Recurring tasks are limited to hourly or slower.
AURA_TASK_WORKER_ID=
AURA_TASK_POLL_SECONDS=5

# Aura private connected services. Create a fresh Fernet key for AURA_CONNECTOR_MASTER_KEY
# and keep it only in deployment secrets. Example generation command:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# The initial Google release requests only selected read-only Drive/Calendar/Gmail scopes.
AURA_CONNECTOR_MASTER_KEY=
AURA_CONNECTOR_HTTP_TIMEOUT=25
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Optional. Blank derives <LSS_PUBLIC_BASE_URL>/aura-intelligence/connectors/google/callback.
GOOGLE_OAUTH_REDIRECT_URI=

# Aura isolated code sandbox adapter. Blank means code execution is disabled. This URL must
# point to a separately isolated sandbox implementing docs/AURA_SANDBOX.md. Member code is
# never executed in the FastAPI process. Requests explicitly require network=false and an
# ephemeral filesystem.
AURA_SANDBOX_URL=
AURA_SANDBOX_TOKEN=
AURA_SANDBOX_TIMEOUT_SECONDS=60
AURA_SANDBOX_MAX_CODE_CHARS=100000
AURA_SANDBOX_MAX_OUTPUT_CHARS=100000

# Aura embodied 3D AI host. The browser GLB renderer is implemented, but the canonical Aura
# rig must actually be installed and pass GLB validation. Keep validation false until the
# real rig/renderer combination has been tested on the deployment/browser matrix.
AURA_AVATAR_ENABLED=true
AURA_AVATAR_ASSET_DIR=aura_music_studio/static/aura
# Blank uses <asset dir>/aura.glb. Paths outside AURA_AVATAR_ASSET_DIR are rejected.
AURA_AVATAR_MODEL_PATH=
# Default renderer is pinned model-viewer 4.3.1. A same-origin vendored module may replace it.
AURA_AVATAR_RENDERER_MODULE_URL=https://ajax.googleapis.com/ajax/libs/model-viewer/4.3.1/model-viewer.min.js
AURA_AVATAR_3D_RENDERER_READY=false

# Aura local vision. Uses the Ollama multimodal chat API when a compatible vision model is
# selected. If blank, Aura reports that visual perception is not configured rather than
# pretending to see image/video content.
AURA_VISION_MODEL=
AURA_VISION_TIMEOUT=180
AURA_VISION_MAX_IMAGE_MB=12

# Pulsar-Frequency House image/video generation bridge.
# Export trusted ComfyUI workflows in API format into AURA_COMFYUI_WORKFLOW_DIR.
# Image and video can use entirely different model/workflow graphs while Aura keeps one project schema.
AURA_COMFYUI_URL=
AURA_COMFYUI_WORKFLOW_DIR=config/comfyui
AURA_COMFYUI_IMAGE_WORKFLOW=
AURA_COMFYUI_VIDEO_WORKFLOW=
AURA_COMFYUI_TIMEOUT_SECONDS=30
AURA_COMFYUI_DOWNLOAD_TIMEOUT_SECONDS=600
AURA_CREATIVE_MAX_OUTPUT_MB=4096

# Private ESP Social Management storage. This contains ESP-member social planning data,
# not ordinary public/member Creative Studio data.
AURA_SOCIAL_ROOT=data/social

# Official ESP social publishing worker. This is a separate privileged process and is OFF
# by default. Do not enable it until the relevant provider app has passed the provider's
# required review/audit and the member has completed OAuth/consent through an official app.
AURA_SOCIAL_PUBLISH_WORKER_ENABLED=false
AURA_SOCIAL_PUBLISH_POLL_SECONDS=10
AURA_SOCIAL_PUBLISH_LEASE_SECONDS=120
AURA_SOCIAL_PUBLISH_WORKER_LOCK_TTL_SECONDS=90
AURA_SOCIAL_PUBLISH_MAX_ACTIONS_PER_CYCLE=25
AURA_SOCIAL_PUBLISH_WORKER_ID=
# Meta Graph API versions are time-bound. Select the version validated for your deployed
# Meta app instead of allowing application code to silently guess a future version.
AURA_META_GRAPH_VERSION=
# SocialConnection.token_secret_ref stores only an alias such as social-token://creator-one.
# The worker maps that alias exclusively to AURA_SOCIAL_TOKEN_CREATOR_ONE. Never place the
# real access token in Social House JSON, source code, screenshots or this example file.
# AURA_SOCIAL_TOKEN_CREATOR_ONE=

# Asynchronous production queue
AURA_JOB_POLL_SECONDS=2
AURA_WORKER_ID=

# Primary standalone real-audio generation: ACE-Step 1.5 REST API
AURA_ACESTEP_API_URL=http://127.0.0.1:8001
ACESTEP_API_KEY=
AURA_ACESTEP_TIMEOUT=1800
AURA_ACESTEP_FULL_MODEL=acestep-v15-xl-turbo
AURA_ACESTEP_TRACK_MODEL=acestep-v15-base
AURA_ACESTEP_SAMPLE_MODEL=acestep-v15-base
AURA_ACESTEP_EDIT_MODEL=

# User-owned rhythm/hum/instrument performance guides.
# Uploads are rights-recorded and may create MIDI/timing guides, but symbolic MIDI is never
# permitted to substitute for the final rendered/mastered audio.
AURA_PERFORMANCE_INPUT_MAX_MB=100

# Optional high-accuracy lyric forced-aligner. Leave blank to use provisional/manual timing.
# Command is parsed as argv without a shell and may use {audio}, {lyrics}, {output} placeholders.
# The output JSON must be: {"lines":[{"start":0.1,"end":1.2,"confidence":0.9}, ...]}
AURA_LYRIC_ALIGN_CMD=
AURA_LYRIC_ALIGN_TIMEOUT_SECONDS=600

# Release-grade music quality gate. New songs retain editable Song DNA and the final master
# is rejected when measurable release checks fail. This does not pretend technical metrics
# can guarantee human-perceived realism; perceptual/listening QA remains a separate stage.
AURA_RELEASE_GATE_STRICT=true

# Other local/open generation engines (optional router choices)
AURA_LOCAL_RENDER_CMD=
AURA_MUSER_CMD=
AURA_YUE_CMD=
AURA_DIFFRHYTHM_CMD=
AURA_AUDIOCRAFT_CMD=
AURA_STABLE_AUDIO_CMD=

# Non-destructive waveform generation/repaint/extend
AURA_REGION_RENDER_CMD=

# Dedicated real-audio layer/sample generators
AURA_LAYER_RENDER_CMD=
AURA_SAMPLE_RENDER_CMD=
AURA_GUITAR_LAYER_CMD=

# Consent-gated singing/voice systems
AURA_DIFFSINGER_CMD=
AURA_SEEDVC_CMD=
AURA_RVC_CMD=

# Aura Tune / professional pitch-correction backend.
# If blank, Aura uses its built-in offline note-region correction fallback.
# A configured backend receives AURA_TUNE_INPUT, AURA_TUNE_OUTPUT, AURA_TUNE_SETTINGS,
# AURA_TUNE_KEY, AURA_TUNE_SCALE, AURA_TUNE_STRENGTH, AURA_TUNE_RETUNE_MS,
# AURA_TUNE_HUMANIZE and AURA_TUNE_FORMANT_PRESERVE in its environment.
AURA_AUTOTUNE_CMD=

# Optional external VST/LV2/plugin host adapter for processors beyond Aura's stock FFmpeg DSP.
AURA_PLUGIN_HOST_CMD=

# Aura speech: offline-first STT/TTS
# STT templates may use {input}/{output}; TTS templates may use {text}/{output}.
AURA_STT_CMD=
AURA_TTS_CMD=
AURA_TTS_URL=
AURA_WHISPER_MODEL=
AURA_PIPER_MODEL=

# Audio restoration / cleanup
# AURA_DENOISE_CMD may use {input}, {output}, {hum_hz}.
AURA_DENOISE_CMD=

# Neural Amp Modeler / compatible tone processor
# Template may use {input}, {model}, {output}, {input_gain_db}, {output_gain_db}.
AURA_NAM_CMD=

# Spatial Audio Framework / compatible binaural or Ambisonic renderer
# Template may use {input}, {output}, {mode}, {azimuth}, {elevation}, {distance}.
AURA_SPATIAL_CMD=

# Advanced source separation
AURA_SEPARATOR_MODEL=
AURA_SEPARATOR_CMD=

# Optional local mastering fallback
AURA_PHASELIMITER_CMD=

# Optional hosted/cloud fallbacks. Leave blank for a fully standalone installation.
DEAPI_API_KEY=
DEAPI_BASE_URL=https://api.deapi.ai
DEAPI_MUSIC_MODEL=AceStep_1_5_XL_Turbo_INT8
DEAPI_TIMEOUT_SECONDS=1800
ELEVENLABS_API_KEY=
MUREKA_API_KEY=
AURA_ACESTEP_SPACES=
HF_TOKEN=

# Score/MIDI control-preview only. Symbolic guides can NEVER become Final Master.
AURA_SOUNDFONT=/usr/share/sounds/sf2/FluidR3_GM.sf2

# Autopilot / local project watcher
AURA_PROJECTS_DIR=projects
AURA_POLL_SECONDS=60

# Shared Sky streaming transport and first-party media runtime.
# All capability switches are fail-closed. Leave disabled/blank until the deployment has
# real ingest, HTTPS playback, FFmpeg and provider authorization where applicable.
SHARED_SKY_VAULT_SECRET=
SHARED_SKY_INGEST_BASE_URL=
SHARED_SKY_RELAY_ENABLED=false
SHARED_SKY_FFMPEG_BIN=ffmpeg
SHARED_SKY_FFPROBE_BIN=ffprobe
SHARED_SKY_DESTINATION_MAX_RETRIES=5
# Multi-host/Battle admission ceiling, including the host. 0 disables additional participant
# admission. The application hard-caps this value at 8. Setting it does not enable WebRTC/SFU;
# guest media remains a separate deployment/readiness gate and must be evidenced independently.
SHARED_SKY_MULTIHOST_MAX_PARTICIPANTS=0

# Built-in first-party HLS origin. For production, point this to the HTTPS route mounted by
# the application, e.g. https://studio.example/shared-sky/media. Never put bearer tokens here.
SHARED_SKY_PLAYBACK_BASE_URL=
SHARED_SKY_PLAYBACK_SIGNING_SECRET=
SHARED_SKY_ALLOW_INSECURE_PLAYBACK=false
SHARED_SKY_INTERNAL_MEDIA_ENABLED=false
SHARED_SKY_INTERNAL_MEDIA_ROOT=data/shared-sky/media
SHARED_SKY_HLS_SEGMENT_SECONDS=2
SHARED_SKY_HLS_WINDOW_SEGMENTS=6
SHARED_SKY_HLS_STARTUP_TIMEOUT_SECONDS=10

# First-party local recording. Keep the root private; API payloads redact physical paths.
SHARED_SKY_RECORDING_LOCAL_ROOT=data/shared-sky/recordings
# Optional external/object-storage handoff URI. Leave blank when using only local recording.
SHARED_SKY_RECORDING_STORAGE_URI=

# YouTube Live API publishing remains disabled until official OAuth Live scope, app eligibility
# and account authorization are verified for the deployment.
SHARED_SKY_YOUTUBE_LIVE_ENABLED=false
