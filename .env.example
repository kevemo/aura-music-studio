# Aura Music Studio runtime configuration
# Copy to .env locally. Never commit real API keys.

AURA_PROJECTS_ROOT=projects

# Direct local/self-hosted ACE-Step 1.5 REST API (`uv run acestep-api`)
AURA_ACESTEP_API_URL=http://127.0.0.1:8001
ACESTEP_API_KEY=
AURA_ACESTEP_TIMEOUT=1800
# Full-song / cover model. XL Turbo is the preferred high-fidelity fast route when hardware supports it.
AURA_ACESTEP_FULL_MODEL=acestep-v15-xl-turbo
# Lego/Extract/Complete are Base-model workflows in ACE-Step 1.5.
AURA_ACESTEP_TRACK_MODEL=acestep-v15-base
AURA_ACESTEP_SAMPLE_MODEL=acestep-v15-base
AURA_ACESTEP_EDIT_MODEL=

# Reliable hosted real-audio engines (optional)
DEAPI_API_KEY=
DEAPI_BASE_URL=https://api.deapi.ai
DEAPI_MUSIC_MODEL=AceStep_1_5_XL_Turbo_INT8
DEAPI_TIMEOUT_SECONDS=1800
ELEVENLABS_API_KEY=
MUREKA_API_KEY=

# Public/hosted ACE-Step failover
AURA_ACESTEP_SPACES=critesjosh/ace-step-music-studio,ACE-Step/Ace-Step-v1.5
HF_TOKEN=

# Local/self-hosted real-audio command renderers. Each command receives AURA_PROJECT,
# AURA_SOURCE, AURA_GUIDE, AURA_PROMPT, AURA_NEGATIVE_PROMPT, AURA_BPM,
# AURA_KEY, AURA_METER, AURA_DURATION and AURA_OUTPUT.
AURA_LOCAL_RENDER_CMD=
AURA_MUSER_CMD=
AURA_YUE_CMD=

# Non-destructive waveform generation/repaint/extend.
# The command must return real waveform audio, never MIDI/SoundFont output.
AURA_REGION_RENDER_CMD=

# Dedicated real-audio layer/sample generators
AURA_LAYER_RENDER_CMD=
AURA_SAMPLE_RENDER_CMD=
AURA_GUITAR_LAYER_CMD=

# Consent-gated singing/voice systems
AURA_DIFFSINGER_CMD=
AURA_SEEDVC_CMD=
AURA_RVC_CMD=

# Advanced source separation
AURA_SEPARATOR_MODEL=
AURA_SEPARATOR_CMD=

# Optional producer-chat planner endpoint. It must return ProducerPlan JSON.
AURA_PRODUCER_LLM_URL=
AURA_PRODUCER_LLM_KEY=

# Score/MIDI control-preview only. These symbolic guides can NEVER become Final Master.
AURA_SOUNDFONT=/usr/share/sounds/sf2/FluidR3_GM.sf2

# Autopilot
AURA_PROJECTS_DIR=projects
AURA_POLL_SECONDS=60
