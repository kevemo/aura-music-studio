# Aura Sec protected-data authority deployment contract.
# Copy these names into the deployment secret/configuration system; do not commit values.
# Cross-user protected-data access fails closed unless the admitted owner personas are explicit.
AURA_SEC_PROTECTED_DATA_PERSONAS=

# Approved Google Drive records-vault folder ID. Keep the real identifier in server-side
# deployment configuration and never expose it through browser-facing application state.
AURA_SEC_PROTECTED_DATA_DRIVE_FOLDER_ID=

# Server-only short-lived/service-identity bearer credential used by the narrow Recovery Vault
# Drive adapter. The application never returns this value to a browser. Production credential
# refresh/issuance remains the deployment identity provider's responsibility.
AURA_SEC_PROTECTED_DATA_DRIVE_BEARER_TOKEN=

# Rotation-aware AES-256-GCM keyring. ACTIVE_KEY_ID selects the write key; older key IDs remain
# in KEYS_JSON while their backups must still be recoverable. KEYS_JSON is a JSON object whose
# values are base64-encoded 32-byte keys. Never commit real keys.
AURA_SEC_RECOVERY_ACTIVE_KEY_ID=
AURA_SEC_RECOVERY_KEYS_JSON=
