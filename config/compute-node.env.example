# ESP Live Sound Studio compute-node settings
# The enrollment tools generate .env.node automatically. Never commit the real file.

LSS_NODE_COORDINATOR_URL=https://your-free-esp-studio-host.example
LSS_NODE_ID=
LSS_NODE_SECRET=
LSS_NODE_NAME=ESP GPU Node
LSS_NODE_CAPABILITIES=music_generation,engineering
LSS_NODE_WORK_DIR=data/node_work
LSS_NODE_HEARTBEAT_SECONDS=30
LSS_NODE_LEASE_SECONDS=3600
LSS_NODE_MAX_BUNDLE_BYTES=2147483648
LSS_NODE_REQUIRE_SAME_VERSION=true
# Keep false for public nodes. Enable HTTP only for a deliberately isolated trusted LAN/test setup.
LSS_NODE_ALLOW_HTTP=false

# Node-local neural renderer used by docker-compose.node.yml
AURA_ACESTEP_API_URL=http://ace-step:8001
AURA_ACESTEP_TIMEOUT=1800
AURA_ACESTEP_FULL_MODEL=acestep-v15-xl-turbo
AURA_ACESTEP_TRACK_MODEL=acestep-v15-base
AURA_ACESTEP_SAMPLE_MODEL=acestep-v15-base
