# Shared Sky Streaming Studios deployment settings
# Copy these names into the deployment secret/environment manager.
# Never commit real stream keys, OAuth tokens or vault secrets.

# Fail closed by default. Set to 1 only after ingest/relay production validation.
SHARED_SKY_RELAY_ENABLED=0

# Long random deployment secret used to encrypt creator-provided stream credentials at rest.
SHARED_SKY_VAULT_SECRET=

# Base contribution ingest URL. Shared Sky appends the random broadcast ID.
# Example shape only: rtmps://ingest.your-domain.example/live
SHARED_SKY_INGEST_BASE_URL=

# Docker already installs ffmpeg. Override only when deployment needs another binary path.
SHARED_SKY_FFMPEG_BIN=ffmpeg
