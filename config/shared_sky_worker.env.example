# Shared Sky durable schedule worker
# Keep disabled until contribution ingest, relay and provider permissions are validated.
SHARED_SKY_SCHEDULER_ENABLED=0

# Poll cadence for due schedules. Minimum enforced by code: 1 second.
SHARED_SKY_SCHEDULER_POLL_SECONDS=5

# A claim lease prevents multiple workers starting the same schedule.
SHARED_SKY_SCHEDULER_LEASE_SECONDS=90

# Bounded retries for transient launch/preflight failures.
SHARED_SKY_SCHEDULER_MAX_ATTEMPTS=3
SHARED_SKY_SCHEDULER_RETRY_SECONDS=30

# Existing Shared Sky media-plane settings are still required before a LIVE schedule can start:
# SHARED_SKY_RELAY_ENABLED=1
# SHARED_SKY_VAULT_SECRET=<deployment secret>
# SHARED_SKY_INGEST_BASE_URL=<authorised ingest base>
# SHARED_SKY_FFMPEG_BIN=ffmpeg
