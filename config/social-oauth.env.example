# ESP Social OAuth deployment settings
# Copy the required values into the deployment .env / secret manager. Never commit real values.

# Generate once and keep stable for the deployment. Rotating this without a migration makes
# existing encrypted social credentials unreadable and requires members to reconnect.
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AURA_SOCIAL_OAUTH_MASTER_KEY=
AURA_SOCIAL_OAUTH_DB_PATH=data/live_sound_studio.sqlite3
AURA_SOCIAL_OAUTH_HTTP_TIMEOUT=25

# TikTok Login Kit + Content Posting API
TIKTOK_OAUTH_CLIENT_KEY=
TIKTOK_OAUTH_CLIENT_SECRET=
# TikTok Web redirect URI must be HTTPS and exactly registered in the TikTok app.
TIKTOK_OAUTH_REDIRECT_URI=

# Instagram API with Instagram Login (professional Business/Creator accounts)
INSTAGRAM_OAUTH_APP_ID=
INSTAGRAM_OAUTH_APP_SECRET=
INSTAGRAM_OAUTH_REDIRECT_URI=
# Pin the Graph API version validated for the deployed Meta app, e.g. v26.0.
AURA_INSTAGRAM_GRAPH_VERSION=

# YouTube Data API v3 / Google OAuth
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=
YOUTUBE_OAUTH_REDIRECT_URI=

# Publishing remains explicitly disabled until provider apps are configured/reviewed as
# applicable and an ESP member has authorised their own account through the private UI.
AURA_SOCIAL_PUBLISH_WORKER_ENABLED=false
