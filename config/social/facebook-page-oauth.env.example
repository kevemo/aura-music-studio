# Facebook Page OAuth deployment contract
#
# This file documents only the bounded member-scoped Facebook Page OAuth path used by
# ESP Social Management. Never commit real Meta credentials, access tokens, Page tokens,
# OAuth authorization codes, state values, or the Fernet master key.
#
# Production activation requires a Meta app approved for the intended Page publishing use
# and the permissions requested by aura_music_studio.esp_social_facebook_oauth.

# Public HTTPS origin used to derive the callback when FACEBOOK_OAUTH_REDIRECT_URI is blank.
LSS_PUBLIC_BASE_URL=https://example.invalid

# Encrypted member OAuth vault. Generate and store this only in deployment secrets.
# Example generation command:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AURA_SOCIAL_OAUTH_MASTER_KEY=
AURA_SOCIAL_OAUTH_DB_PATH=data/live_sound_studio.sqlite3
AURA_SOCIAL_OAUTH_HTTP_TIMEOUT=25

# Meta Graph version must be selected and validated for the deployed Meta application.
# AURA_FACEBOOK_GRAPH_VERSION takes precedence; AURA_META_GRAPH_VERSION is the shared fallback.
AURA_FACEBOOK_GRAPH_VERSION=
AURA_META_GRAPH_VERSION=

# Meta application credentials. FACEBOOK_* names take precedence; META_* are accepted aliases.
FACEBOOK_OAUTH_APP_ID=
FACEBOOK_OAUTH_APP_SECRET=
META_OAUTH_APP_ID=
META_OAUTH_APP_SECRET=

# Optional explicit callback. Blank derives:
# <LSS_PUBLIC_BASE_URL>/command-center/api/social/oauth/facebook/callback
FACEBOOK_OAUTH_REDIRECT_URI=

# Runtime scope truth (documentation only; do not turn these into secrets):
# pages_show_list
# pages_manage_posts
# pages_read_engagement
#
# The user must explicitly select the numeric Facebook Page ID before OAuth starts.
# Completion verifies the required permissions and resolves only that selected Page from
# /me/accounts. Only the selected Page access token is stored, encrypted, in the member vault.
# Social House JSON receives only a social-oauth:// credential reference.
