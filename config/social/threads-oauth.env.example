# ESP Social Manager — Threads member OAuth
# Copy only the variable names you need into the protected deployment secret/config store.
# Never commit real Meta credentials or OAuth user tokens.

# Meta Threads App credentials from the Meta App Dashboard Threads use case.
THREADS_OAUTH_APP_ID=
THREADS_OAUTH_APP_SECRET=

# Must exactly match an HTTPS redirect URI configured for the Threads app.
# If omitted, the application derives:
#   ${LSS_PUBLIC_BASE_URL}/command-center/api/social/oauth/threads/callback
THREADS_OAUTH_REDIRECT_URI=https://your-command-center.example/command-center/api/social/oauth/threads/callback

# Shared encrypted Social OAuth vault key. Generate one Fernet key for the deployment and
# preserve it across restarts/backups. Existing OAuth credentials cannot be decrypted if it changes.
AURA_SOCIAL_OAUTH_MASTER_KEY=

# Public HTTPS origin used to derive OAuth callback URLs when provider-specific redirect variables
# are not supplied.
LSS_PUBLIC_BASE_URL=https://your-command-center.example

# Optional provider HTTP timeout, bounded by the runtime to 5–120 seconds.
AURA_SOCIAL_OAUTH_HTTP_TIMEOUT=25

# Runtime requests only these Threads permissions for the currently implemented single-post publisher:
#   threads_basic
#   threads_content_publish
# Replies, insights, mentions, keyword search, location tagging and other permissions are NOT requested.
