{
    # Elevate Souls Productions owns the application and data. Caddy is used only as the local
    # reverse proxy/TLS terminator. With a real hostname it obtains and renews HTTPS
    # certificates automatically; direct-IP fallback can use http://:80.
    admin off
}

{$LSS_PUBLIC_SITE_ADDRESS:http://:80} {
    encode zstd gzip

    header {
        -Server
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
    }

    request_body {
        max_size 300MB
    }

    reverse_proxy live-sound-studio:8000 {
        # Overwrite the internal proxy-auth header before upstream routing. The application
        # accepts forwarded client/scheme identity only after this shared high-entropy token verifies.
        header_up X-ESP-Proxy-Auth "{$LSS_TRUSTED_PROXY_TOKEN:__proxy_token_missing__}"

        health_uri /health/ready
        health_interval 30s
        health_timeout 5s
    }
}
