# Aura canonical 3D character build adapters
# These commands run on a dedicated Linux/NVIDIA 3D build host. Do not place API keys or private tokens here.

# Approved multiview Aura references. Expected files:
#   front.png (required)
#   face.png, turnaround.png, left.png, right.png, back.png (strongly recommended)
AURA_AVATAR_REFERENCE_DIR=data/aura_character_references

# Production canonical model served by the application.
AURA_AVATAR_MODEL_PATH=aura_music_studio/static/aura/aura.glb

# Strict mobile delivery budgets. Override only after measured browser profiling.
AURA_AVATAR_MAX_TRIANGLES=160000
AURA_AVATAR_MAX_BYTES=41943040

# -----------------------------------------------------------------------------
# Stage 1 — PBR reconstruction
# -----------------------------------------------------------------------------
# Approved Aura references -> high-fidelity textured PBR GLB.
# Recommended current path: Microsoft TRELLIS.2.
# Available placeholders:
# {reference_dir} {front} {face} {turnaround} {left} {right} {back} {output} {identity} {spec}
AURA_AVATAR_IMAGE_TO_3D_CMD=
# Included build-host adapter example:
# AURA_AVATAR_IMAGE_TO_3D_CMD=python scripts/aura_3d/trellis2_reconstruct.py --input {turnaround} --output {output}
AURA_TRELLIS2_MODEL=microsoft/TRELLIS.2-4B
AURA_TRELLIS2_MIN_VRAM_GB=23
AURA_TRELLIS2_DECIMATION=220000
AURA_TRELLIS2_TEXTURE_SIZE=4096

# -----------------------------------------------------------------------------
# Stage 2 — skeleton + skinning
# -----------------------------------------------------------------------------
# Recommended current path: VAST-AI-Research SkinTokens / TokenRig (successor to UniRig).
AURA_AVATAR_RIG_CMD=
# Included adapter example:
# AURA_AVATAR_RIG_CMD=python scripts/aura_3d/skintokens_rig.py --input {input} --output {output}
AURA_SKINTOKENS_ROOT=
AURA_SKINTOKENS_PYTHON=python

# -----------------------------------------------------------------------------
# Stage 3 — face / speech / emotion rig
# -----------------------------------------------------------------------------
# This stage must preserve Aura's exact approved face and create:
# - VRM vowel/blink/look presets
# - Aura custom emotion expressions
# - detailed ARKit-compatible facial morph targets
# - independent eyelids/eyes/jaw/lips/brows/cheeks/nose controls
# Available placeholders include {input} {output} {face} {turnaround} {identity} {spec}.
AURA_AVATAR_FACE_CMD=

# -----------------------------------------------------------------------------
# Stage 4 — authored body animation
# -----------------------------------------------------------------------------
# Must supply at least Idle, Walk, Talk, Listen, Think, PointLeft, PointRight, Present, Celebrate.
# Optional advanced clips include Welcome, Explain, Agree, Acknowledge, Search, Create, Translate, Goodbye.
AURA_AVATAR_ANIMATION_CMD=

# -----------------------------------------------------------------------------
# Stage 5 — VRM 1.0 finalisation
# -----------------------------------------------------------------------------
# Must create VRMC_vrm humanoid/expression/LookAt data and VRMC_springBone hair physics.
# Required semantic material names/aliases include Aura_Skin, Aura_Eyes, Aura_Hair, Aura_Suit,
# Aura_Heart_Core and Aura_Circuitry. Eyes, heart and circuitry must support live emissive control.
AURA_AVATAR_VRM_CMD=

# -----------------------------------------------------------------------------
# Stage 6 — mobile/web packaging
# -----------------------------------------------------------------------------
# Must retain skinning, morph targets, animations and VRM metadata while applying modern delivery
# compression. The production gate requires KTX2/Basis textures and mesh compression.
AURA_AVATAR_MOBILE_CMD=
# Included high-quality adapter example:
# AURA_AVATAR_MOBILE_CMD=python scripts/aura_3d/mobile_pack.py --input {input} --output {output}
AURA_GLTF_TRANSFORM=gltf-transform
AURA_AVATAR_MESHOPT_LEVEL=medium

# Optional future timing-aware TTS/viseme adapter. The current runtime already animates from
# real audio energy and standard VRM vowel expressions; timestamps can improve articulation.
AURA_TTS_TIMING_URL=
