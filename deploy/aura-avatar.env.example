# Aura canonical 3D character build adapters
# These commands run on a dedicated 3D/GPU build host. Do not place API keys or private tokens here.

# Approved multiview Aura references. Expected files:
#   front.png (required)
#   left.png, right.png, back.png (strongly recommended)
AURA_AVATAR_REFERENCE_DIR=data/aura_character_references

# Production canonical model served by the application.
AURA_AVATAR_MODEL_PATH=aura_music_studio/static/aura/aura.glb

# Stage 1: approved Aura references -> high-fidelity textured PBR GLB.
# Recommended implementation candidates: Microsoft TRELLIS.2 or Tencent Hunyuan3D.
# Available placeholders: {reference_dir} {front} {left} {right} {back} {output}
AURA_AVATAR_IMAGE_TO_3D_CMD=

# Stage 2: generated GLB -> humanoid skeleton + skinning.
# Recommended implementation candidates: UniRig or RigAnything.
# Available placeholders: {input} {output} {reference_dir} {front} {left} {right} {back}
AURA_AVATAR_RIG_CMD=

# Stage 3: rigged humanoid -> VRM 1.0 + Aura facial expressions/material naming/secondary motion.
# This stage must create VRMC_vrm humanoid mappings and expressions required by
# docs/AURA_CANONICAL_3D_CHARACTER.md.
# Available placeholders: {input} {output} {identity} {spec} and the reference placeholders above.
AURA_AVATAR_VRM_CMD=

# Optional future timing-aware TTS/viseme adapter. The current runtime already animates from
# real audio energy and standard VRM vowel expressions; timestamps can improve articulation.
AURA_TTS_TIMING_URL=
