# Shared Skies Media — production contract
# Powered by Elevate Souls Productions
# Copy values into your deployment secret store. NEVER commit the completed file.
# Blank values are deliberate: production must fail closed until the real value is supplied.

AURA_DEPLOYMENT_ENV=production
LSS_DEPLOYMENT_MODE=selfhost
LSS_PUBLIC_BASE_URL=
LSS_PUBLIC_SITE_ADDRESS=
# Optional comma-separated additional same-origin browser origins. Production request security
# does not trust/reflect the incoming Host header into this allowlist.
AURA_ALLOWED_ORIGINS=
LSS_COOKIE_SECURE=true
AURA_WEB_ALLOW_HTTP=false

# Reverse-proxy identity. Generate at least 32 random bytes and supply the same secret to Caddy and
# the application. Uvicorn does not trust X-Forwarded-* directly; the application accepts Caddy's
# forwarding only after this shared token verifies.
LSS_TRUSTED_PROXY_TOKEN=

# Authentication abuse admission shared across application workers on the current SQLite topology.
LSS_AUTH_RATE_LIMIT=12
LSS_AUTH_RATE_WINDOW_SECONDS=900

# Owner/provenance secrets — generate unique high-entropy values out of band.
LSS_ADMIN_KEY=
LSS_PROVENANCE_SECRET=

# Verified PayPal invoice evidence. Browser redirects/manual returns are never payment proof.
LSS_PAYMENT_PROVIDER=paypal
LSS_PAYMENT_MODE=verified_paypal_invoice
LSS_PAYPAL_ENVIRONMENT=live
LSS_PAYPAL_CLIENT_ID=
LSS_PAYPAL_CLIENT_SECRET=
LSS_PAYPAL_WEBHOOK_ID=
LSS_PAYPAL_BASE_URL=
LSS_PAYPAL_PRO_URL=
# Server-only HMAC secret used to bind native Shared Skies Rhiannon OS/Shared Skies Security checkout metadata to the
# intended account/product/period before PayPal checkout. Generate at least 32 random bytes.
LSS_NATIVE_PAYPAL_METADATA_SECRET=

# Explicit provider-secret allowlist for this production deployment. List only providers you enable.
# Every named environment variable must hold a non-placeholder secret before readiness passes.
AURA_PRODUCTION_REQUIRED_PROVIDER_SECRETS=
ELEVENLABS_API_KEY=
MUREKA_API_KEY=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
AURA_CONNECTOR_MASTER_KEY=

# Release supply-chain verification. This is the public verification key path/URI used by the
# deployment host. The private signing key must never be placed in this runtime environment file.
COSIGN_VERIFY_KEY=

# GPU / ACE-Step. The renderer remains private to the Compose network.
AURA_GPU_REQUIRED=true
AURA_GPU_MIN_VRAM_GB=12
AURA_REQUIRE_LIVE_RENDERER=true
AURA_ACESTEP_API_URL=http://ace-step:8001
ACESTEP_API_KEY=
AURA_ACESTEP_FULL_MODEL=acestep-v15-xl-turbo
AURA_ACESTEP_TRACK_MODEL=acestep-v15-base
AURA_ACESTEP_SAMPLE_MODEL=acestep-v15-base
ACESTEP_QUEUE_MAXSIZE=100
# Required explicit CUDA device/MIG assignment for the Phase-1 single-host release.
AURA_ACESTEP_CUDA_VISIBLE_DEVICES=

# Private Rhiannon inference. The model directory must already have a verified integrity manifest.
AURA_SELFHOST_LLM_MODEL_DIR=
AURA_SELFHOST_LLM_SERVED_NAME=aura-reasoning
AURA_LLM_INTERNAL_API_KEY=
# Must not overlap AURA_ACESTEP_CUDA_VISIBLE_DEVICES on the single-host topology.
AURA_LLM_CUDA_VISIBLE_DEVICES=
AURA_LLM_TENSOR_PARALLEL_SIZE=1
AURA_LLM_GPU_MEMORY_UTILIZATION=0.90
AURA_LLM_MAX_MODEL_LEN=65536

# Monitoring. Token protects /internal/metrics; readiness never returns this value.
AURA_MONITORING_ENABLED=true
AURA_MONITORING_TOKEN=

# Encrypted automatic backups. Keep the age PRIVATE identity offline/out of the application.
LSS_AUTO_BACKUP_ENABLED=true
LSS_AUTO_BACKUP_INTERVAL_HOURS=12
LSS_AUTO_BACKUP_KEEP=14
LSS_AUTO_BACKUP_INCLUDE_OUTPUTS=false
LSS_AUTO_BACKUP_INCLUDE_WORK=true
LSS_BACKUP_AGE_RECIPIENT=

# Durable production paths inside the container stack.
LSS_DB_PATH=/app/data/live_sound_studio.sqlite3
AURA_PROJECTS_ROOT=/app/projects
LSS_BACKUP_DIR=/app/backups

# Recommended worker bounds.
AURA_JOB_POLL_SECONDS=2
AURA_TASK_POLL_SECONDS=5
# Enable only after the relevant provider apps, permissions and encrypted OAuth credentials are
# configured. The production runner activates the social-publishing profile only when this is true.
AURA_SOCIAL_PUBLISH_WORKER_ENABLED=false
