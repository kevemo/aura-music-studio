# ESP Live Sound Studio — private neural renderer settings
# Copy only the values you need into the deployment .env. Never commit real secrets.

# Live deployments using a renderer overlay force this true automatically.
AURA_REQUIRE_LIVE_RENDERER=true

# ACE-Step 1.5 — primary renderer
# Generate a long random value for defense-in-depth between private containers.
ACESTEP_API_KEY=
AURA_ACESTEP_FULL_MODEL=acestep-v15-xl-turbo
AURA_ACESTEP_TRACK_MODEL=acestep-v15-base
AURA_ACESTEP_SAMPLE_MODEL=acestep-v15-base
ACESTEP_LM_MODEL_PATH=acestep-5Hz-lm-4B
ACESTEP_LLM_BACKEND=pt
ACESTEP_QUEUE_MAXSIZE=100
AURA_ACESTEP_TIMEOUT=1800

# YuE — optional heavy lyrics-first renderer
YUE_API_KEY=
AURA_YUE_STAGE1_MODEL=m-a-p/YuE-s1-7B-anneal-en-cot
AURA_YUE_STAGE2_MODEL=m-a-p/YuE-s2-1B-general
# Official YuE guidance recommends keeping this low on <=24GB GPUs.
AURA_YUE_MAX_SEGMENTS=2
AURA_YUE_STAGE2_BATCH_SIZE=4
AURA_YUE_MAX_NEW_TOKENS=3000
AURA_YUE_TIMEOUT=7200
AURA_YUE_POLL_SECONDS=5
YUE_CUDA_IDX=0
YUE_JOB_TIMEOUT_SECONDS=7200
YUE_REPETITION_PENALTY=1.1
