# Elevate Souls Productions Content Creation Command Center — staging contract
# Use sandbox/test credentials only. Never reuse the production .env file.

AURA_DEPLOYMENT_ENV=staging
LSS_PUBLIC_BASE_URL=https://staging-command-center.example.com
LSS_COOKIE_SECURE=true
AURA_WEB_ALLOW_HTTP=false

# Staging-only owner/provenance values.
LSS_ADMIN_KEY=
LSS_PROVENANCE_SECRET=

# PayPal sandbox is mandatory in staging readiness.
LSS_PAYMENT_PROVIDER=paypal
LSS_PAYMENT_MODE=verified_paypal_invoice
LSS_PAYPAL_ENVIRONMENT=sandbox
LSS_PAYPAL_CLIENT_ID=
LSS_PAYPAL_CLIENT_SECRET=
LSS_PAYPAL_WEBHOOK_ID=
LSS_PAYPAL_BASE_URL=
LSS_PAYPAL_PRO_URL=

# Staging provider credentials must belong to test/developer apps.
AURA_PRODUCTION_REQUIRED_PROVIDER_SECRETS=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
AURA_CONNECTOR_MASTER_KEY=

# GPU can be real or disabled for CPU/API-only staging. When enabled, use a staging key.
AURA_GPU_REQUIRED=false
AURA_REQUIRE_LIVE_RENDERER=false
AURA_ACESTEP_API_URL=http://ace-step:8001
ACESTEP_API_KEY=
AURA_GPU_MIN_VRAM_GB=12

# Staging observability may use its own token.
AURA_MONITORING_ENABLED=true
AURA_MONITORING_TOKEN=

# Staging backups are useful for restore drills but remain isolated from production archives.
LSS_AUTO_BACKUP_ENABLED=true
LSS_AUTO_BACKUP_INTERVAL_HOURS=24
LSS_AUTO_BACKUP_KEEP=7
LSS_AUTO_BACKUP_INCLUDE_OUTPUTS=false
LSS_AUTO_BACKUP_INCLUDE_WORK=true
LSS_BACKUP_AGE_RECIPIENT=

LSS_DB_PATH=/app/data/live_sound_studio.sqlite3
AURA_PROJECTS_ROOT=/app/projects
LSS_BACKUP_DIR=/app/backups
AURA_SOCIAL_PUBLISH_WORKER_ENABLED=false
