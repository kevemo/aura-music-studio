{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "development/full-site-build": false,
      "feature/aura-platform-core": false,
      "feature/core-email-verification": false,
      "feature/core-password-recovery-sessions": false,
      "feature/esp-command-centers": false,
      "feature/creative-studios-game-forge": false,
      "feature/hourly-auto-build": false,
      "feature/stripe-billing": false,
      "feature/production-security-gates-v2": false,
      "feature/pro-creative-editors-v2": false,
      "feature/pro-editor-workspace": false,
      "feature/pro-editor-compositor": false,
      "feature/owner-finance-dashboard": false,
      "feature/owner-finance-dashboard-v2": false,
      "feature/global-compliance-i18n": false,
      "feature/privacy-rights-consent-v2": false,
      "feature/privacy-rights-consent-v3": false,
      "feature/privacy-case-management": false
    }
  },
  "functions": {
    "vercel_bootstrap.py": {
      "maxDuration": 60,
      "excludeFiles": "{tests/**,preview/**,docs/**,deploy/**,.github/**,docker-compose*.yml,*.md,*.pdf,*.docx}"
    }
  }
}
