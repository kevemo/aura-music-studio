{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "development/full-site-build": false,
      "feature/aura-platform-core": false,
      "feature/core-email-verification": false,
      "feature/esp-command-centers": false,
      "feature/creative-studios-game-forge": false,
      "feature/hourly-auto-build": false
    }
  },
  "functions": {
    "vercel_bootstrap.py": {
      "maxDuration": 60,
      "excludeFiles": "{tests/**,preview/**,docs/**,deploy/**,.github/**,docker-compose*.yml,*.md,*.pdf,*.docx}"
    }
  }
}
